# Wave Configuration for REMOTE access to nexushive
# Server running on nexushive, client on another machine

# === CLIENT SETTINGS (used by Emacs) ===
# These configure the Emacs Wave client
export WAVE_CLIENT_USER="$USER@$(hostname)"  # e.g. jwalsh@laptop
export WAVE_CLIENT_DOMAIN=""  # empty = no domain suffix needed

# === SERVER CONNECTION (where client connects to) ===
# Point to nexushive.lan for remote access
export WAVE_SERVER_HOST="nexushive.lan"
export WAVE_SERVER_PORT="9898"
export WAVE_SERVER_URL="http://nexushive.lan:9898"
export WAVE_WS_URL="ws://nexushive.lan:9898/ws"

# === SERVER SETTINGS (used by FastAPI) ===
# The server always binds to 0.0.0.0:9898 (all interfaces)
export DATABASE_URL="sqlite:///./wave_server.db"

# === OPTIONAL SETTINGS ===
export WAVE_DEBUG="false"
export EMACS_BIN="emacs"