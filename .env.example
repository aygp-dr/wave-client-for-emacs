# Wave Client Configuration
# Copy this file to .env and uncomment/modify values as needed

# Wave client user (your email or username)
# This will be used for wave-client-user in Emacs
# export WAVE_CLIENT_USER="user@localhost"

# Wave client domain (leave empty for localhost)
# This will be used for wave-client-domain in Emacs
# export WAVE_CLIENT_DOMAIN=""

# Wave server host (default: localhost)
# export WAVE_SERVER_HOST="localhost"

# Wave server port (default: 9898)
# export WAVE_SERVER_PORT="9898"

# Wave server URL (constructed from host and port)
# export WAVE_SERVER_URL="http://localhost:9898"

# Wave WebSocket URL (for real-time updates)
# export WAVE_WS_URL="ws://localhost:9898/ws"

# Database URL (SQLite by default)
# export DATABASE_URL="sqlite:///./wave_server.db"

# Debug mode (set to true for verbose logging)
# export WAVE_DEBUG="false"

# Emacs binary path (for dashboard)
# export EMACS_BIN="emacs"