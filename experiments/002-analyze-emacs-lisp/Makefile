.PHONY: help run clean

help: ## Show experiment 002 commands
	@echo "Experiment 002: Analyze Emacs Lisp Implementation"
	@echo "Commands:"
	@echo "  make run    # Analyze Emacs Lisp client code"
	@echo "  make clean  # Clean generated files"

run: ## Analyze Emacs Lisp client architecture (FPO)
	@echo "🧪 Experiment 002: Analyzing Emacs Lisp implementation"
