# Experiment 001: recover the 2009-10 server-side code from the Google Code
# Archive. Downloads go to a throwaway temp dir, never into the repo; only
# small text files land in results/. Nothing from the archive is executed:
# hg reads the store (with .hg/hgrc deleted first), javap only disassembles.
#
# Needs: curl, unzip, shasum, uvx (runs Mercurial from PyPI), javap (any JDK).

SHELL := /bin/bash
.SHELLFLAGS := -euo pipefail -c

ARCHIVE_URL := https://storage.googleapis.com/google-code-archive-source/v2/code.google.com/wave-client-for-emacs/source-archive.zip
ARCHIVE_SHA256 := 1e387ec3a18b57b7a0717e7a683a73f7ac50ccc58d1b3bd14302798e231790d1
HG := HGRCPATH= HGPLAIN=1 uvx -q --from mercurial hg
FEDONE := org.waveprotocol.wave.examples.fedone
JAVAP_CLASSES := \
	$(FEDONE).rpc.SequencedProtoChannel \
	$(FEDONE).rpc.ClientRpcChannel \
	$(FEDONE).rpc.ServerRpcProvider \
	$(FEDONE).waveclient.common.ClientBackend \
	$(FEDONE).waveclient.common.ClientUtils \
	$(FEDONE).waveclient.common.IndexEntry \
	$(FEDONE).waveserver.ClientFrontend \
	$(FEDONE).waveserver.ClientFrontendImpl \
	$(FEDONE).waveserver.WaveClientRpcImpl \
	$(FEDONE).common.HashedVersion \
	$(FEDONE).ServerMain \
	$(FEDONE).FlagSettings

.PHONY: help run clean

help: ## Show experiment 001 commands
	@grep -E '^[a-z]+:.*## ' $(MAKEFILE_LIST) | sed 's/:.*## /\t/'

run: ## Download the archive to a temp dir and regenerate results/
	work=$$(mktemp -d); trap 'rm -rf "$$work"' EXIT; \
	curl -fsSL -o "$$work/source-archive.zip" '$(ARCHIVE_URL)'; \
	echo "$(ARCHIVE_SHA256)  $$work/source-archive.zip" | shasum -a 256 -c -; \
	unzip -q "$$work/source-archive.zip" -d "$$work/x"; \
	repo="$$work/x/wave-client-for-emacs"; \
	rm -f "$$repo/.hg/hgrc"; \
	mkdir -p results/hg results/proto "$$work/jars"; \
	$(HG) -R "$$repo" log --template '{rev}:{node|short} {date|isodate} {branch} {author|person} | {desc|firstline}\n' > results/hg-log.txt; \
	for spec in src/client.clj:2,4,5,8,14 start-repl.sh:3,4,2 build.xml:0 README:2 lisp/wave-client.el:4,14 \
	            third-party/runtime/wave-protocol/README:0; do \
	  path=$${spec%%:*}; name=$$(basename "$$path"); \
	  [ "$$path" = third-party/runtime/wave-protocol/README ] && name=wave-protocol-README; \
	  for rev in $${spec##*:}; do rev=$${rev//,/ }; for r in $$rev; do \
	    $(HG) -R "$$repo" cat -r "$$r" "path:$$path" > "results/hg/$$name.r$$r"; done; done; \
	done; \
	for jar in wave-protocol/fedone-api-0.2.jar wave-protocol/fedone-server-0.2.jar; do \
	  $(HG) -R "$$repo" cat -r 14 "path:third-party/runtime/$$jar" > "$$work/jars/$$(basename $$jar)"; \
	done; \
	server="$$work/jars/fedone-server-0.2.jar"; \
	for proto in $$(unzip -Z1 "$$server" | grep '\.proto$$'); do \
	  unzip -p "$$server" "$$proto" > "results/proto/$$(basename $$proto)"; done; \
	{ echo "# javap -p summary, fedone-server-0.2.jar (hg rev 14). Generated by 'gmake run'."; \
	  echo; echo "## .proto files and RPC/frontend classes in the jar"; \
	  unzip -Z1 "$$server" | grep -E '\.proto$$|/rpc/[A-Za-z]+\.class$$|waveserver/(ClientFrontend|WaveClientRpc)[A-Za-z]*\.class$$|websocket|jetty|servlet' || true; \
	  echo; echo "## class signatures"; \
	  javap -p -cp "$$server" $(JAVAP_CLASSES) | grep -v 'access\$$'; \
	  echo; echo "## SequencedProtoChannel.sendMessage(long, Message): wire framing"; \
	  javap -c -p -cp "$$server" $(FEDONE).rpc.SequencedProtoChannel \
	    | sed -n '/public void sendMessage(long, com.google.protobuf.Message);/,/^$$/p' \
	    | grep -E 'CodedOutputStream\.(write|compute)|getFullName' | sed 's/^ *[0-9]*: //'; \
	  echo; echo "## string constants"; \
	  javap -c -p -constants -cp "$$server" $(FEDONE).common.CommonConstants $(FEDONE).waveserver.ClientFrontendImpl \
	    | grep -E 'ldc .*String (indexwave|digest|digest-author|conv\+root)$$' | sed 's/^ *[0-9]*: //' | sort -u; \
	  javap -constants -p -cp "$$server" $(FEDONE).waveclient.common.ClientUtils | grep DEFAULT_DOCUMENT_ID; \
	  javap -v -p -cp "$$server" $(FEDONE).FlagSettings | grep -E 'name="client_frontend'; \
	  echo; echo "## HashedVersion: unsigned(v) has an empty hash; version zero hashes the wavelet URI"; \
	  javap -c -p -cp "$$server" $(FEDONE).common.HashedVersion | sed -n '/HashedVersion unsigned(long)/,/areturn/p' | sed 's/^ *[0-9]*: //'; \
	  javap -c -p -cp "$$server" $(FEDONE).model.util.HashedVersionZeroFactoryImpl \
	    | sed -n '/createVersionZero/,/areturn/p' | grep -E 'waveletNameToURI|getBytes' | sed 's/^ *[0-9]*: //'; \
	} > results/javap-summary.txt; \
	du -sh results

clean: ## Remove generated results
	rm -rf results/
