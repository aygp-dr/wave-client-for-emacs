.PHONY: help run clean

help: ## Show experiment 001 commands
	@echo "Experiment 001: Explore Server Code"
	@echo "Commands:"
	@echo "  make run    # Extract and analyze Clojure server code"
	@echo "  make clean  # Clean generated files"

run: ## Extract and analyze Clojure server code (FPO)
	@echo "🧪 Experiment 001: Exploring server code from Mercurial history"
	@echo "📁 Creating results directory..."
	@mkdir -p results
	@echo "🔍 [FPO] Extracting src/client.clj from .hg/store/data/"
	@echo "   TODO: hg debugdata or direct file extraction"
	@echo "🔍 [FPO] Analyzing fedone-api dependencies"
	@echo "   TODO: Extract and examine JAR contents"
	@echo "🔍 [FPO] Documenting Clojure architecture"
	@echo "   TODO: Create architecture.md with findings"
	@echo "📝 [FPO] Generating recommendations"
	@echo "   TODO: Compare Clojure vs Python implementation options"
	@echo "✅ Experiment 001 complete (placeholder)"
	@echo "   Results would be in: results/"

clean: ## Clean generated files
	rm -rf results/
	@echo "Cleaned experiment 001 results"