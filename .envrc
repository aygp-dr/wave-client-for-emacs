#!/usr/bin/env bash
# direnv configuration for wave-client-for-emacs

# Load .env file if it exists
if [[ -f .env ]]; then
    set -a
    source .env
    set +a
fi

# Set default values if not already set
export WAVE_CLIENT_USER="${WAVE_CLIENT_USER:-user@localhost}"
export WAVE_CLIENT_DOMAIN="${WAVE_CLIENT_DOMAIN:-}"
export WAVE_SERVER_HOST="${WAVE_SERVER_HOST:-localhost}"
export WAVE_SERVER_PORT="${WAVE_SERVER_PORT:-9898}"
export WAVE_SERVER_URL="${WAVE_SERVER_URL:-http://$WAVE_SERVER_HOST:$WAVE_SERVER_PORT}"
export WAVE_WS_URL="${WAVE_WS_URL:-ws://$WAVE_SERVER_HOST:$WAVE_SERVER_PORT/ws}"
export DATABASE_URL="${DATABASE_URL:-sqlite:///./wave_server.db}"
export WAVE_DEBUG="${WAVE_DEBUG:-false}"
export EMACS_BIN="${EMACS_BIN:-emacs}"

# Activate Python virtual environment if using uv
if command -v uv >/dev/null 2>&1; then
    eval "$(uv venv --quiet)"
fi

# Print configuration on load
echo "Wave Client Environment Loaded:"
echo "  User: $WAVE_CLIENT_USER"
echo "  Domain: ${WAVE_CLIENT_DOMAIN:-localhost}"
echo "  Server: $WAVE_SERVER_URL"
echo "  WebSocket: $WAVE_WS_URL"