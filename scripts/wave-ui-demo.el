;;; wave-ui-demo.el --- Drive the Wave UI in batch and print each screen -*- lexical-binding: t -*-
;; Run: gmake elisp-ui-demo (needs gmake server db-seed). Mutates the seeded DB.
(setq auth-sources nil)
(require 'wave-ui)
(setq wave-client-ws-url "ws://localhost:9898/socket" wave-client-user "alice@localhost" wave-client-domain "localhost")
(defun show (label) (message "===== %s =====\n%s%s" label (if header-line-format (concat (format "%s" header-line-format) "\n") "") (buffer-substring-no-properties (point-min) (point-max))))
(wave) (show "inbox")
(wave-ui-goto-folder "by-me") (show "by-me")
(wave-ui-search "with:bob is:unread") (show "search with:bob is:unread")
(wave-ui-goto-folder "inbox")
(goto-char (point-min)) (search-forward "New to Wave")
(wave-ui-open) (show "open rsvp wave")
(wave-ui-vote "no") (show "after vote no")
(switch-to-buffer "*Wave*") (wave-ui-refresh)
(goto-char (point-min)) (search-forward "Google I/O")
(wave-ui-open)
(goto-char (point-min)) (search-forward "hello all")
(wave-ui-reply-to-blip "reply typed in emacs")
(show "io wave after reply")
